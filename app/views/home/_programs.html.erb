<section id="programs" class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-sm font-semibold uppercase tracking-wider text-[#E97A9D]">Programs</span>
    <h2 class="mt-4 text-3xl font-bold tracking-tight text-[#2D2D2D] sm:text-4xl">
      A program for every chapter of you
    </h2>
    <p class="mt-4 text-lg text-[#6B7280]">
      Thoughtfully designed journeys that meet your body and life stage exactly where they are.
    </p>
  </div>

  <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% [
      { title: "Weight Loss", description: "Sustainable movement and nutrition rhythms built around your metabolism.", gradient: "from-[#E97A9D] to-[#F8C9A5]" },
      { title: "PCOS Wellness", description: "Hormone-conscious yoga and nutrition guidance for lasting balance.", gradient: "from-[#D8C6F2] to-[#E97A9D]" },
      { title: "Pregnancy Yoga", description: "Gentle, trimester-aware practices to support you and your baby.", gradient: "from-[#F8C9A5] to-[#D8C6F2]" },
      { title: "Meditation", description: "Guided stillness practices to quiet the mind and steady the breath.", gradient: "from-[#E97A9D] to-[#D8C6F2]" },
      { title: "Stress Relief", description: "Restorative rituals to release tension and restore your nervous system.", gradient: "from-[#F8C9A5] to-[#E97A9D]" },
      { title: "Strength & Mobility", description: "Functional strength training rooted in mindful, low-impact movement.", gradient: "from-[#D8C6F2] to-[#F8C9A5]" }
    ].each do |program| %>
      <div class="group overflow-hidden rounded-3xl border border-[#F1E6E8] bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-[#E97A9D]/10">
        <div class="relative aspect-[16/10] w-full bg-gradient-to-br <%= program[:gradient] %>">
          <div class="absolute inset-0 bg-white/10"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-12 w-12 text-white/80">
              <path d="M12 3C12 3 7 8 7 13a5 5 0 0 0 10 0c0-5-5-10-5-10Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div class="p-7">
          <h3 class="text-lg font-semibold text-[#2D2D2D]"><%= program[:title] %></h3>
          <p class="mt-2 text-sm leading-relaxed text-[#6B7280]"><%= program[:description] %></p>
          <a href="#" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-[#E97A9D] transition group-hover:gap-2.5">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    <% end %>
  </div>
</section>
