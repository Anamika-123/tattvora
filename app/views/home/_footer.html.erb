<footer class="border-t border-[#F1E6E8] bg-white">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <div class="grid grid-cols-2 gap-10 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <%= link_to root_path, class: "flex items-center gap-2" do %>
          <span class="flex h-9 w-9 items-center justify-center rounded-2xl bg-gradient-to-br from-[#E97A9D] to-[#F8C9A5] text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
              <path d="M12 3C12 3 7 8 7 13a5 5 0 0 0 10 0c0-5-5-10-5-10Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="text-lg font-semibold tracking-tight text-[#2D2D2D]">Tattvora</span>
        <% end %>
        <p class="mt-4 text-sm leading-relaxed text-[#6B7280]">
          AI-powered holistic wellness for women &mdash; yoga, meditation, nutrition and Ayurveda in one calm space.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-[#2D2D2D]">Quick Links</h3>
        <ul class="mt-4 space-y-3 text-sm text-[#6B7280]">
          <li><a href="#programs" class="transition hover:text-[#E97A9D]">Programs</a></li>
          <li><a href="#features" class="transition hover:text-[#E97A9D]">About</a></li>
          <li><a href="#pricing" class="transition hover:text-[#E97A9D]">Pricing</a></li>
          <li><%= link_to "Sign In", new_user_session_path, class: "transition hover:text-[#E97A9D]" %></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-[#2D2D2D]">Resources</h3>
        <ul class="mt-4 space-y-3 text-sm text-[#6B7280]">
          <li><a href="#" class="transition hover:text-[#E97A9D]">Blog</a></li>
          <li><a href="#" class="transition hover:text-[#E97A9D]">Wellness Guides</a></li>
          <li><a href="#" class="transition hover:text-[#E97A9D]">FAQs</a></li>
          <li><a href="#" class="transition hover:text-[#E97A9D]">Privacy Policy</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-[#2D2D2D]">Contact</h3>
        <ul class="mt-4 space-y-3 text-sm text-[#6B7280]">
          <li>hello@tattvora.com</li>
          <li>+91 98765 43210</li>
          <li>Mumbai, India</li>
        </ul>
