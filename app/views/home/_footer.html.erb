    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-6 border-t border-[#F1E6E8] pt-8 sm:flex-row">
      <p class="text-sm text-[#6B7280]">&copy; <%= Date.current.year %> Tattvora. All rights reserved.</p>

      <div class="flex items-center gap-4">
        <a href="#" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full border border-[#F1E6E8] text-[#6B7280] transition hover:border-[#E97A9D]/40 hover:text-[#E97A9D]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor"/>
          </svg>
        </a>
        <a href="#" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full border border-[#F1E6E8] text-[#6B7280] transition hover:border-[#E97A9D]/40 hover:text-[#E97A9D]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
            <path d="M14 9h2V6h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V9Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#" aria-label="X" class="flex h-9 w-9 items-center justify-center rounded-full border border-[#F1E6E8] text-[#6B7280] transition hover:border-[#E97A9D]/40 hover:text-[#E97A9D]">
