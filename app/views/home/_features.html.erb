<section id="features" class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <span class="text-sm font-semibold uppercase tracking-wider text-[#E97A9D]">Why Tattvora</span>
    <h2 class="mt-4 text-3xl font-bold tracking-tight text-[#2D2D2D] sm:text-4xl">
      Holistic wellness, thoughtfully engineered
    </h2>
    <p class="mt-4 text-lg text-[#6B7280]">
      Every feature is crafted to meet you where you are and grow with you, one mindful step at a time.
    </p>
  </div>

  <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    <% [
      {
        icon: "M12 2l2.4 5.5L20 9l-4.6 3.4L16.9 18 12 14.9 7.1 18l1.5-5.6L4 9l5.6-1.5L12 2Z",
        title: "AI Personalisation",
        description: "Adaptive programs that learn from your body, mood and progress to guide every session."
      },
      {
        icon: "M12 21c-4.4-2.7-8-6.2-8-10.5A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 8 4.5C20 14.8 16.4 18.3 12 21Z",
        title: "Expert Teachers",
        description: "Learn from certified yoga, nutrition and Ayurveda specialists curated for quality and care."
      },
      {
        icon: "M12 2v20M2 12h20M6 6l12 12M18 6L6 18",
        title: "Holistic Wellness",
        description: "Yoga, meditation, nutrition and Ayurveda woven into a single, harmonious practice."
      },
      {
        icon: "M4 19h16M7 15l3-4 3 3 4-6",
        title: "Progress Tracking",
        description: "Gentle, meaningful insights into your journey so growth always feels visible."
      }
    ].each do |feature| %>
      <div class="group rounded-3xl border border-[#F1E6E8] bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-[#E97A9D]/10">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-[#E97A9D]/15 to-[#F8C9A5]/25 text-[#E97A9D] transition group-hover:from-[#E97A9D] group-hover:to-[#F8C9A5] group-hover:text-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6">
            <path d="<%= feature[:icon] %>" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="mt-6 text-lg font-semibold text-[#2D2D2D]"><%= feature[:title] %></h3>
        <p class="mt-2 text-sm leading-relaxed text-[#6B7280]"><%= feature[:description] %></p>
      </div>
    <% end %>
  </div>
</section>
