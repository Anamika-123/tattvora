<section class="relative overflow-hidden pt-40 pb-24 lg:pt-48 lg:pb-32">
  <div class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-[#F8C9A5]/40 blur-3xl"></div>
  <div class="pointer-events-none absolute top-40 -left-32 h-96 w-96 rounded-full bg-[#D8C6F2]/40 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-16 px-6 lg:grid-cols-2 lg:px-8">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-[#F1E6E8] bg-white px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-[#E97A9D] shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5">
          <path d="M12 2l1.9 5.8L20 10l-6.1 2.2L12 18l-1.9-5.8L4 10l6.1-2.2L12 2Z" fill="currentColor"/>
        </svg>
        AI-Powered Wellness for Women
      </span>

      <h1 class="mt-8 text-4xl font-bold leading-[1.1] tracking-tight text-[#2D2D2D] sm:text-5xl lg:text-6xl">
        Personalised Wellness,
        <span class="bg-gradient-to-r from-[#E97A9D] to-[#D8C6F2] bg-clip-text text-transparent">Designed Around You.</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#6B7280]">
        Tattvora blends yoga, meditation, nutrition and Ayurveda with intelligent AI guidance to craft a wellness journey that adapts to your body, your goals and your life.
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
        <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center rounded-full bg-gradient-to-r from-[#E97A9D] to-[#F8C9A5] px-8 py-4 text-base font-semibold text-white shadow-lg shadow-[#E97A9D]/25 transition hover:shadow-xl hover:shadow-[#E97A9D]/30" do %>
          Get Started
        <% end %>
        <a href="#programs" class="inline-flex items-center justify-center gap-2 rounded-full border border-[#F1E6E8] bg-white px-8 py-4 text-base font-semibold text-[#2D2D2D] transition hover:border-[#E97A9D]/40 hover:text-[#E97A9D]">
          Explore Programs
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="mt-14 flex items-center gap-8 border-t border-[#F1E6E8] pt-8">
        <div>
          <p class="text-2xl font-bold text-[#2D2D2D]">50k+</p>
          <p class="text-sm text-[#6B7280]">Women guided</p>
        </div>
        <div class="h-8 w-px bg-[#F1E6E8]"></div>
        <div>
          <p class="text-2xl font-bold text-[#2D2D2D]">4.9/5</p>
          <p class="text-sm text-[#6B7280]">Average rating</p>
        </div>
        <div class="h-8 w-px bg-[#F1E6E8]"></div>
        <div>
          <p class="text-2xl font-bold text-[#2D2D2D]">120+</p>
          <p class="text-sm text-[#6B7280]">Expert teachers</p>
        </div>
      </div>
    </div>

    <div class="relative">
      <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-[#E97A9D] via-[#D8C6F2] to-[#F8C9A5] shadow-2xl shadow-[#E97A9D]/20">
        <div class="absolute inset-0 bg-white/10"></div>
        <div class="absolute inset-6 flex items-center justify-center rounded-[2rem] border border-white/30 backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-28 w-28 text-white/80">
            <path d="M12 2C12 2 6 8 6 13.5S8.7 22 12 22s6-3.8 6-8.5S12 2 12 2Z" stroke="currentColor" stroke-width="1.2"/>
            <circle cx="12" cy="9" r="4" stroke="currentColor" stroke-width="1.2"/>
          </svg>
        </div>
        <p class="absolute bottom-8 left-8 right-8 text-sm font-medium text-white/90">Premium yoga &amp; wellness imagery placeholder</p>
      </div>

      <div class="absolute -bottom-8 -left-8 w-64 rounded-3xl border border-[#F1E6E8] bg-white p-5 shadow-xl">
        <div class="flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#7BBF8A]/15 text-[#7BBF8A]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
              <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <div>
            <p class="text-sm font-semibold text-[#2D2D2D]">Today&rsquo;s Practice</p>
            <p class="text-xs text-[#6B7280]">Morning flow &middot; 20 min</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
